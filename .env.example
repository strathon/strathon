# Strathon environment overrides.
# Copy to .env to customize. All values shown are the defaults; uncomment
# only what you want to change. The receiver works with no .env at all.

# ---- Postgres ----
# POSTGRES_PASSWORD=strathon_dev

# ---- Receiver logging ----
# STRATHON_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
# STRATHON_LOG_FORMAT=text         # text | json (json emits one record per line)

# ---- Database pool ----
# STRATHON_DB_POOL_SIZE=10
# STRATHON_DB_MAX_OVERFLOW=20
# STRATHON_DB_POOL_TIMEOUT=30
# STRATHON_DB_POOL_RECYCLE=3600
# STRATHON_DB_ECHO=false           # true to log all SQL queries

# ---- Sampling ----
# STRATHON_SAMPLING_RATE=1.0       # 0.0-1.0. Always-keep rules still apply.

# ---- Retention ----
# STRATHON_RETENTION_ENABLED=true
# STRATHON_RETENTION_INTERVAL_SECONDS=3600
# STRATHON_RETENTION_BATCH_SIZE=5000
# STRATHON_SPAN_PARTITION_RETENTION_MONTHS=12

# ---- Authentication / RBAC ----
# STRATHON_REGISTRATION_ENABLED=true    # false to require admin invitation
# STRATHON_SESSION_TTL_HOURS=24         # dashboard session lifetime (1-720)
# STRATHON_COOKIE_SECURE=false          # (dashboard) set true only when serving the dashboard over HTTPS
# STRATHON_LOGIN_RATE_LIMIT_ATTEMPTS=5  # max login attempts per IP per window
# STRATHON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# STRATHON_LOCKOUT_ATTEMPTS=10          # lock account after N failed attempts
# STRATHON_LOCKOUT_MINUTES=15
# STRATHON_MAX_SESSIONS=5               # max concurrent sessions per user
# STRATHON_PASSWORD_PEPPER=            # extra secret mixed into password hashing (hex).
#   generate: python -c 'import secrets; print(secrets.token_hex(32))'
# STRATHON_ADMIN_API_KEY=               # bootstraps non-interactive admin access; unset
                                        # disables it. Set only for automation, never a
                                        # guessable value.
# STRATHON_REGISTER_GLOBAL_LIMIT_PER_MINUTE=30  # cap on new registrations per minute across
                                        # all IPs (the per-IP limit is above). 0 disables.

# ---- Hardening ----
# STRATHON_REQUIRE_SECURITY_KEYS=false # true makes missing security keys a hard boot
                                       # failure instead of a startup warning.
                                       # Recommended for any internet-facing deployment.

# ---- Security ----
# STRATHON_ENCRYPTION_KEY=            # Fernet key, encrypts stored TOTP secrets at rest.
#   generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# STRATHON_AUDIT_HMAC_KEY=            # signs the audit hash chain (at least 32 bytes).
#   generate: python -c 'import secrets; print(secrets.token_hex(32))'
# STRATHON_AUDIT_ANCHOR_INTERVAL_SECONDS=60
# STRATHON_AUDIT_HOT_MONTHS=24            # months of audit events on the hot tier
# STRATHON_DOCS_ENABLED=false           # true to expose /docs (Swagger UI)
# STRATHON_CORS_ORIGINS=http://localhost:3000
# STRATHON_METRICS_AUTH_TOKEN=           # optional bearer token for /metrics
# STRATHON_PUBLIC_URL=                   # public base URL of the receiver, used to build
                                         # links in outbound notifications (approval
                                         # approve/deny links). Defaults to
                                         # http://localhost:4318 -- set to your
                                         # reverse-proxy address or notification links
                                         # won't work for anyone off the box.
# STRATHON_SEED_DEV_KEY=false           # true seeds the well-known local dev key
                                        # (stra_dev_local_default_project_do_not_use_in_production)
                                        # into the default project on first migration, so the
                                        # quickstart curl and examples/ scripts work without
                                        # registering first. Off by default -- the key value is
                                        # PUBLIC (see docs/api_keys.md). Only enable for local
                                        # dev; NEVER on an internet-facing host.

# ---- Rate limiting ----
# STRATHON_RATE_LIMIT_ENABLED=true
# STRATHON_RATE_LIMIT_REQUESTS_PER_SECOND=100
# STRATHON_RATE_LIMIT_BURST=200
# STRATHON_RATE_LIMIT_TRUST_FORWARDED_FOR=false   # only true when running behind a trusted
                                                  # reverse proxy (nginx real_ip, ALB, Cloudflare)
                                                  # that overwrites X-Forwarded-For with the
                                                  # real client IP. Default false: attacker
                                                  # cannot forge XFF to escape rate limits.
                                                  # Authenticated requests key off the API key
                                                  # and are unaffected.

# ---- Webhooks ----
# STRATHON_WEBHOOK_MAX_ATTEMPTS=5
# STRATHON_WEBHOOK_MIN_BACKOFF_MS=1000
# STRATHON_WEBHOOK_MAX_BACKOFF_MS=60000
# STRATHON_WEBHOOK_REQUEST_TIMEOUT_SEC=10
# STRATHON_WEBHOOK_SIGNING_SECRETS=     # comma-separated HMAC keys
# STRATHON_WEBHOOK_REDIS_URL=           # Redis URL for the webhook delivery queue. Empty
                                        # uses the in-process broker (fine for a single
                                        # receiver); set this to share a queue across
                                        # multiple receiver instances.

# ---- Circuit breakers ----
# STRATHON_CB_ERROR_THRESHOLD=5
# STRATHON_CB_WINDOW_SECONDS=60
# STRATHON_CB_COOLDOWN_SECONDS=30
# STRATHON_CB_HALF_OPEN_MAX=3

# ---- Behavioral drift (Vigil) ----
# STRATHON_VIGIL_EWMA_ALPHA=0.3
# STRATHON_VIGIL_CUSUM_THRESHOLD=5.0
# STRATHON_VIGIL_CUSUM_DRIFT=1.0
# STRATHON_VIGIL_MIN_SPANS=50

# ---- Cost / budget evaluation ----
# STRATHON_EXPENSIVE_LLM_TOKEN_THRESHOLD=5000  # token count above which a call is treated
                                        # as expensive for cost policies.
# STRATHON_BUDGET_EVAL_INTERVAL_SECONDS=300
# STRATHON_BUDGET_MAX_PER_TICK=100

# ---- Agent heartbeat ----
# STRATHON_HEARTBEAT_TIMEOUT_SECONDS=300

# ---- Deployment mode ----
# STRATHON_MODE=self-hosted         # self-hosted | cloud
# STRATHON_AUTO_MIGRATE=true        # run alembic upgrade head on startup

# ---- Integrations ----
# STRATHON_SLACK_SIGNING_SECRET=    # Slack app signing secret
# STRATHON_EGRESS_RECEIVER_URL=     # URL for egress proxy

# ---- Email (optional, for password reset) ----
# STRATHON_SMTP_HOST=
# STRATHON_SMTP_PORT=587
# STRATHON_SMTP_USER=
# STRATHON_SMTP_PASSWORD=
# STRATHON_SMTP_FROM=noreply@getstrathon.com

# ---- AI policy generation (optional -- enables --from-english in the CLI) ----
# Supports Anthropic (sk-ant-...) or OpenAI (sk-...) keys.
# STRATHON_AI_API_KEY=
