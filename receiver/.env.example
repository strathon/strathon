# Strathon Receiver — Environment Variables
# ==============================================================
# For docker-compose users: this file is for reference only. The
# real .env sits next to docker-compose.yml at the repo root and
# is auto-loaded — see the root .env.example instead.
#
# For bare-metal Python users (running the receiver directly with
# uvicorn/python, not via docker-compose): copy this file to .env
# and fill in values. The receiver does NOT auto-load .env; export
# the variables into your shell before starting the process:
#
#     set -a; source .env; set +a
#     uvicorn receiver.main:app --host 0.0.0.0 --port 4318
#
# Or use a systemd unit with EnvironmentFile=/path/to/.env.
# All variables are optional except DATABASE_URL.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://strathon:strathon_dev@localhost:5432/strathon

# ── Mode ──────────────────────────────────────────────────────
# self-hosted (default): single-tenant. Boots with zero config for local
#   trials; missing security keys fall back to dev defaults with loud
#   startup warnings.
# cloud: reserved for the hosted multi-tenant deployment.
STRATHON_MODE=self-hosted

# Hard-fail on missing security keys: when true the receiver REFUSES to
# start without STRATHON_AUDIT_HMAC_KEY, STRATHON_ENCRYPTION_KEY, and
# STRATHON_PASSWORD_PEPPER (always enforced in cloud mode). Recommended
# for any internet-facing deployment.
STRATHON_REQUIRE_SECURITY_KEYS=false

# Registration abuse limits. Per-IP: shares the login limiter (5/min per
# IP by default). Global backstop for distributed floods: total
# registrations per minute across all IPs (0 disables).
STRATHON_REGISTER_GLOBAL_LIMIT_PER_MINUTE=30

# ── Security ──────────────────────────────────────────────────
# HMAC key for tamper-evident audit log hash chain.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
STRATHON_AUDIT_HMAC_KEY=

# Fernet key for column-level encryption (TOTP secrets).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRATHON_ENCRYPTION_KEY=

# Secret prepended to passwords before Argon2id hashing.
# Even with full DB access, attacker can't crack passwords without this.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
STRATHON_PASSWORD_PEPPER=

# Seed the public, well-known local dev API key
# (stra_dev_local_default_project_do_not_use_in_production) into the
# default project on first migration. Off by default because the key
# value is PUBLIC; only enable for local dev, never on an
# internet-facing host. Also gated by mode != cloud.
STRATHON_SEED_DEV_KEY=false

# ── Registration ──────────────────────────────────────────────
# Set to false after creating initial admin account.
STRATHON_REGISTRATION_ENABLED=true

# ── Session ───────────────────────────────────────────────────
# Dashboard session lifetime (1-720 hours).
STRATHON_SESSION_TTL_HOURS=24

# ── Rate Limiting ─────────────────────────────────────────────
# Max failed login attempts per IP per window before back-off.
STRATHON_LOGIN_RATE_LIMIT_ATTEMPTS=5
STRATHON_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Trust X-Forwarded-For for the per-IP rate-limit bucket on unauthenticated
# requests. Only set true when Strathon runs behind a trusted reverse proxy
# (nginx real_ip, an ALB, Cloudflare) that overwrites the header with the
# real client IP. Default false: an attacker cannot forge XFF to escape the
# limit. Authenticated requests key off the API key and are unaffected.
STRATHON_RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ── Account Lockout ───────────────────────────────────────────
STRATHON_LOCKOUT_ATTEMPTS=5
STRATHON_LOCKOUT_MINUTES=15
STRATHON_MAX_SESSIONS=10

# ── Production Hardening ──────────────────────────────────────
# Enable Swagger UI (/docs, /redoc). Default: disabled.
STRATHON_DOCS_ENABLED=false

# Bearer token required to access /metrics endpoint.
STRATHON_METRICS_AUTH_TOKEN=

# Comma-separated list of allowed CORS origins.
STRATHON_CORS_ORIGINS=http://localhost:3000

# Public base URL of this receiver, used to build links in outbound
# notifications (e.g. approve/deny links in approval requests). If left at
# the default, notification links point to localhost and won't work for
# anyone off the box. Set to your reverse-proxy address in production.
STRATHON_PUBLIC_URL=http://localhost:4318

# Resolve and validate webhook destination IPs at delivery time to block
# SSRF (including DNS-rebinding). Leave enabled in production; only turn
# off for test suites using mock transports.
STRATHON_WEBHOOK_SSRF_GUARD=true

# ── Tuning (defaults are sensible; change only with a reason) ─
# Seconds a project's compiled policy set is cached in-process before
# re-reading from Postgres. Lower = faster policy propagation, more DB reads.
STRATHON_POLICY_CACHE_TTL=5.0

# Token count above which a single LLM call is flagged "expensive" in
# analytics and incident heuristics.
STRATHON_EXPENSIVE_LLM_TOKEN_THRESHOLD=5000

# Hours between runs of the daily auxiliary-data cleanup task (expired
# sessions, expired API keys, old resolved approvals; never audit events).
# Separate from STRATHON_RETENTION_INTERVAL_SECONDS, which schedules
# span/trace retention.
STRATHON_RETENTION_INTERVAL_HOURS=24

# ── AI policy generation (optional) ───────────────────────────
# Enables the plain-English policy generator (dashboard "Generate from
# description" and CLI `policies create --from-english`). Accepts an
# Anthropic (sk-ant-...) or OpenAI (sk-...) key. Unset = feature returns
# a clear 501.
STRATHON_AI_API_KEY=

# ── Email (optional, for password reset) ──────────────────────
STRATHON_SMTP_HOST=
STRATHON_SMTP_PORT=587
STRATHON_SMTP_USER=
STRATHON_SMTP_PASSWORD=
STRATHON_SMTP_FROM=noreply@getstrathon.com

# ── Webhook signing (optional) ────────────────────────────────
# Comma-separated whsec_* plaintexts created via POST
# /v1/webhook_signing_keys. Persisting them here lets alert-webhook
# signing survive receiver restarts (only hashes live in the DB).
STRATHON_WEBHOOK_SIGNING_SECRETS=

# ── Slack Integration ─────────────────────────────────────────
STRATHON_SLACK_SIGNING_SECRET=

# ── Vigil (behavioral drift detection) ────────────────────────
STRATHON_VIGIL_MIN_SPANS=100
STRATHON_VIGIL_EWMA_ALPHA=0.3
STRATHON_VIGIL_CUSUM_THRESHOLD=5.0

# ── Circuit Breakers ──────────────────────────────────────────
STRATHON_CB_ERROR_THRESHOLD=10
STRATHON_CB_WINDOW_SECONDS=300
STRATHON_CB_COOLDOWN_SECONDS=60
